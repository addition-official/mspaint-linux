[Desktop Entry]
Type=Application
Name=Paint
GenericName=Image Editor
Comment=Draw, edit and annotate pictures in the style of Windows 11 Paint
Exec=mspaint-linux %f
Icon=mspaint-linux
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=paint;mspaint;draw;image;picture;editor;brush;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-pixmap;image/qoi;
StartupWMClass=mspaint-linux
StartupNotify=true
