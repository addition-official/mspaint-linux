[Desktop Entry]
Type=Application
Name=Paintbox
GenericName=Paint Program
Comment=Draw, edit and annotate pictures
Exec=paintbox %f
Icon=io.github.addition_official.Paintbox
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=paint;draw;drawing;image;picture;editor;brush;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/x-portable-pixmap;image/qoi;
StartupWMClass=io.github.addition_official.Paintbox
StartupNotify=true
